rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function tripData(t) {
      return get(/databases/$(database)/documents/trips/$(t)).data;
    }
    function isMember(t) {
      return signedIn() && me() in tripData(t).memberEmails;
    }
    function isTripAdmin(data) {
      return me() == data.adminEmail || me() in data.get('adminEmails', []);
    }
    function settingsPath() {
      return /databases/$(database)/documents/app/settings;
    }
    // Pemilik aplikasi: admin trip pertama ("main"), atau ownerEmail di app/settings.
    function isOwner() {
      return signedIn() && (exists(settingsPath())
        ? me() == get(settingsPath()).data.ownerEmail
        : me() == tripData('main').adminEmail);
    }
    function canCreateTrips() {
      return isOwner() || (signedIn() && exists(settingsPath()) && me() in get(settingsPath()).data.get('creatorEmails', []));
    }

    // Siapa saja yang boleh membuat trip baru (diatur pemilik di tab Admin).
    match /app/settings {
      allow read: if signedIn();
      allow create: if isOwner() && request.resource.data.ownerEmail == me();
      allow update: if isOwner() && request.resource.data.ownerEmail == resource.data.ownerEmail;
    }

    // Preferensi pribadi (trip terakhir dibuka).
    match /users/{email} {
      allow read, write: if signedIn() && me() == email;
    }

    match /trips/{tripId} {
      // Daftar "Trip saya": hanya trip yang memuat email pengguna.
      allow read: if signedIn() && me() in resource.data.memberEmails;
      allow create: if canCreateTrips()
        && me() in request.resource.data.memberEmails
        && request.resource.data.adminEmail == me();
      // Admin boleh mengubah anggota/admin; anggota biasa hanya field lain.
      allow update: if signedIn() && me() in resource.data.memberEmails && (
        isTripAdmin(resource.data)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberEmails', 'adminEmail', 'adminEmails'])
      );
      allow delete: if signedIn() && isTripAdmin(resource.data) && tripId != 'main';

      match /{collection}/{docId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
